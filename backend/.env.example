ENVIRONMENT=development
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://amanipulse:amanipulse@localhost:55432/amanipulse
REDIS_URL=redis://localhost:56379/0
ENABLE_AI_WORKER=true
CELERY_TASK_ALWAYS_EAGER=false
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
REPORT_ENCRYPTION_KEY=replace-with-fernet-key-from-python-command
INTERNAL_API_TOKEN=replace-with-strong-internal-review-token
# Store only SHA-256 hashes of internal review tokens in PostgreSQL.
# The Alembic development seed supports dev-internal-review-token locally.
